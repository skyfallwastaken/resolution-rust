<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{% block title %}Resolution Rust{% endblock %}</title>

    <link href="/static/styles/tailwind.css?v={{ css_asset_version }}" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/prism-themes@1/themes/prism-one-dark.min.css"
    />
  </head>

  <body class="bg-base text-text">
    <main id="swup" class="transition-fade">
      {% block content %}{% endblock %}
    </main>

    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-clike.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-rust.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-toml.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-bash.min.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-json.min.js"
    ></script>

    <script type="module">
      import Swup from "https://unpkg.com/swup@4?module";
      import SwupHeadPlugin from "https://unpkg.com/@swup/head-plugin@2?module";

      const swup = new Swup({
        plugins: [new SwupHeadPlugin()],
      });

      const LINE_THRESHOLD = 16;

      const collapseCodeBlocks = () => {
        document.querySelectorAll("pre > code").forEach((code) => {
          const pre = code.parentElement;
          if (pre.classList.contains("code-collapsible")) return;

          const lineCount = code.textContent.split("\n").length - 1;
          if (lineCount <= LINE_THRESHOLD) return;

          pre.classList.add("code-collapsible");

          const btn = document.createElement("button");
          btn.className = "code-expand-btn";
          btn.textContent = `▼ Show all ${lineCount} lines`;
          btn.addEventListener("click", () => {
            const expanded = pre.classList.toggle("is-expanded");
            btn.textContent = expanded
              ? "▲ Collapse"
              : `▼ Show all ${lineCount} lines`;
          });

          pre.after(btn);
        });
      };

      const highlight = () => {
        if (window.Prism) {
          window.Prism.highlightAll();
        }
        collapseCodeBlocks();
      };

      window.addEventListener("load", highlight);
      swup.hooks.on("page:view", highlight);
    </script>
  </body>
</html>
